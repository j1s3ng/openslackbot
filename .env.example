# Slack Socket Mode
# Use real values only in .env or a secret provider. Do not commit secrets.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_MONITORED_CHANNEL_IDS=

# LM Studio OpenAI-compatible local endpoint
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gpt-oss-120b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT_SECONDS=300

# Local services
DATABASE_URL=postgresql+psycopg://local_rag:local_rag_dev_password@localhost:5432/local_slack_rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# Retrieval models hosted locally
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=Qwen3-Embedding-8B
RERANKER_BASE_URL=http://localhost:1234/v1
RERANKER_MODEL=Qwen3-Reranker-8B
RERANKER_FALLBACK_MODEL=Qwen3-Reranker-4B

# RAG defaults
RAG_TOP_K=12
RAG_CHUNK_MIN_TOKENS=500
RAG_CHUNK_MAX_TOKENS=900
RAG_CONCEPTUAL_CHUNK_MAX_TOKENS=1500

# Crawler defaults
CRAWLER_USER_AGENT=LocalRAGBot/1.0
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_RATE_LIMIT_PER_HOST_PER_MINUTE=30
CRAWLER_MAX_CONCURRENT_REQUESTS_PER_HOST=2
CRAWLER_MAX_PAGES_PER_SYNC=10000

# Example connector secret reference, not a secret value:
# VENDOR_DOCS_API_TOKEN=
