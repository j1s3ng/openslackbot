# ── Slack App Tokens ──────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# ── LM Studio ────────────────────────────────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gptoss120b
SYSTEM_PROMPT=You are a helpful, concise assistant in a Slack workspace. Answer clearly and directly.

# ── RAG (fully local, no external services) ──────────────────────────────────
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=openslackbot
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=http://localhost:1234/v1  # uncomment to use a separate endpoint
RAG_CHUNK_SIZE=2048
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=5

# ── Tool settings ────────────────────────────────────────────────────────────
MAX_TOOL_ROUNDS=5
